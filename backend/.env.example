# P2P Backend — Environment Configuration
#
# Copy this file to .env.local for local development.
# Never commit .env or .env.local.

# Application environment.
NODE_ENV=development

# Backend HTTP server port.
PORT=4000

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgres://p2p_backend:p2p_dev_password@127.0.0.1:5432/p2p_backend

# Maximum number of PostgreSQL connections.
DB_POOL_MAX=10

# Enable PostgreSQL TLS.
# Keep false for local development; use true when required by the
# production database provider.
DB_SSL=false