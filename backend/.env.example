# P2P backend — environment configuration.
# Copy this file to .env.local for local development. No secrets are
# defined here yet beyond a local development database URL — see
# README.md for how to run PostgreSQL locally.

# development | test | production
NODE_ENV=development

# Port the backend HTTP server listens on.
PORT=4000

# Frontend origin allowed to call this API cross-origin (CORS). Set to
# wherever the Next.js frontend actually runs. Required as of L3-P05
# for the browser-based real-time (SSE) client at /events/stream.
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
# Required only once something imports src/db/client.ts (nothing in the
# running app does yet — see docs/CURRENT_STATUS.md). Not needed to run
# `npm run dev`/`npm test` otherwise.
DATABASE_URL=postgres://p2p_backend:p2p_dev_password@127.0.0.1:5432/p2p_backend

# Max connections in the pool. Optional — defaults to 10.
DB_POOL_MAX=10

# Whether to connect over TLS. Optional — defaults to false (fine for
# local development; a hosted Postgres provider will typically need
# DB_SSL=true).
DB_SSL=false
