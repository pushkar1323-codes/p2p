# P2P — Environment Configuration Example
#
# Copy this file to `.env.local` and adjust values as needed.
# Never commit `.env` or `.env.local` — they are Git-ignored.
#
# All values below are PUBLIC network configuration only.
# Do not put private keys, seed phrases, or API secrets in
# NEXT_PUBLIC_* variables — anything prefixed NEXT_PUBLIC_ is
# bundled into client-side code and is publicly visible.

# Stellar network to use. TESTNET is required through Level 5.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Stellar network passphrase for Testnet.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Horizon (classic Stellar API) endpoint.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for smart contract interaction.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed loan_registry contract ID (Stellar Testnet). Public
# contract identifier, not a secret. See
# contracts/loan_registry/DEPLOYMENTS.md for the full deployment
# record (deployer address, transaction hashes — kept local-only).
NEXT_PUBLIC_LOAN_REGISTRY_CONTRACT_ID=CAKENBWT2237ASCTOZMFOMQTYWYRXQRMVX7N2OYGH67P7YMJFOD2L7YA
