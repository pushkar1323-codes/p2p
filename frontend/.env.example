# P2P Frontend — Environment Configuration
#
# Copy this file to .env.local for local development.
# Never commit .env or .env.local.
#
# NEXT_PUBLIC_* values are exposed to the browser.
# Never put private keys, seed phrases, or API secrets here.

# Stellar network.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Stellar Testnet network passphrase.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Horizon API endpoint.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Loan Registry contract used by the application.
# Set this to the deployed Testnet contract ID.
NEXT_PUBLIC_LOAN_REGISTRY_CONTRACT_ID=

# Deployed eligibility_registry contract ID. Same non-secret status as
# above. REQUIRED — there is no built-in fallback for this one (see
# src/config/stellar.ts): this contract has been redeployed before
# with an incompatible storage model, so a stale hardcoded default
# would silently point the app at the wrong instance. Set this to the
# currently deployed self-registration instance (the one exposing
# register()/admin_block()/admin_unblock(), not the old admin-grant
# set_eligibility() one) — see
# contracts/eligibility_registry/DEPLOYMENTS.md for the deployment
# record.
NEXT_PUBLIC_ELIGIBILITY_REGISTRY_CONTRACT_ID=

# Testnet's native XLM asset as a Stellar Asset Contract — not
# something this project deployed; every Stellar network already has
# this contract for its native asset. Obtained via
# `stellar contract id asset --network testnet --asset native`. The
# one token this app currently supports for lender funding (L3-P12).
# Public contract ID, not a secret.
NEXT_PUBLIC_NATIVE_XLM_SAC_CONTRACT_ID=

# Backend API base URL.
# Used for API requests and real-time event streaming.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000