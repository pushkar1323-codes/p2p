# P2P Contracts — Deployment Configuration Example
#
# Copy this file to `.env` (inside contracts/) and adjust if needed —
# the defaults below already match Stellar Testnet and this project's
# frontend config (see the root .env.example). `contracts/.env` is
# Git-ignored (see contracts/.gitignore).
#
# This file is consumed by contracts/scripts/deploy_testnet.sh, a
# plain shell script — not the Next.js app — so none of these need a
# NEXT_PUBLIC_ prefix.
#
# IMPORTANT — NO SECRET KEY GOES IN THIS FILE, EVER.
# Deployment authenticates via the Stellar CLI's own local identity
# keystore (`stellar keys ...`), not a raw secret key in an env file.
# DEPLOYER_IDENTITY below is just the *name* of that local identity,
# not a secret. See contracts/scripts/deploy_testnet.sh's header
# comment for how to create one.

# Network to deploy to. This project uses Testnet through Level 5
# (see 00_MASTER_RULES.md #7).
STELLAR_NETWORK=testnet

# Soroban RPC endpoint for Testnet.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Testnet network passphrase (public, standard, same for everyone —
# not a secret). Matches NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE in
# the root .env.example.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Name of a local Stellar CLI identity to deploy with (see
# `stellar keys --help`). This is a LABEL, not a secret — the actual
# key material lives in the Stellar CLI's own local keystore on your
# machine, never in this file or the repo.
DEPLOYER_IDENTITY=p2p-testnet-deployer
