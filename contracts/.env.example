# P2P Contracts — Environment Configuration
#
# Copy this file to .env inside contracts/ for local deployment.
# Never commit .env or any secret key material.

# Stellar Testnet configuration.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Local Stellar CLI identity used for deployment.
# The identity's key material is stored in the Stellar CLI keystore.
DEPLOYER_IDENTITY=p2p-testnet-deployer

# Eligibility Registry contract used by loan_registry.
# Set this to the deployed Testnet contract ID when running
# initialization or configuration scripts.
ELIGIBILITY_REGISTRY_CONTRACT_ID=

# Loan Registry contract being initialized or configured.
# Set this to the deployed Testnet contract ID when required
# by the deployment scripts.
LOAN_REGISTRY_CONTRACT_ID=

# Optional administrator identity.
# Defaults to DEPLOYER_IDENTITY when not specified.
#ADMIN_IDENTITY=p2p-testnet-deployer

# Optional public borrower address for the allow-listing script.
# A command-line argument can be used instead.
#TEST_BORROWER_ADDRESS=